# ─── Required ────────────────────────────────────────────────────────────────

# Secret used to sign JWTs — must be a long, random string (min 32 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=production

# Directory where the SQLite database is stored
DATA_DIR=./data

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI Provider Keys (optional — can also be configured via the UI) ──────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=

# ─── Supabase (optional) ──────────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
